# ============================================================================
# MediConnect AI - environment variables
#
# How to use:
#   1. Copy this file and rename the copy to ".env"
#   2. Fill in only the values you need (everything is optional)
#   3. Restart the terminal / dev server after changing values
#
# ".env" is listed in .gitignore, so your secrets are NEVER committed to Git.
# Anything starting with VITE_ is visible in the browser - only put PUBLIC
# values there. AI keys belong to the backend section (server-side only).
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND (browser-visible) - Supabase
# Leave empty and the app runs in local demo mode (data saved in your browser).
# Get these free at https://supabase.com -> Project Settings -> API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# BACKEND (server-side ONLY, never exposed to the browser) - AI chatbot
# Recommended: Groq free tier -> https://console.groq.com/keys
# Leave every AI key empty and the chatbot runs in clearly-labelled demo mode.
# ----------------------------------------------------------------------------
AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides (defaults are shown; Groq is the default provider)
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------------------------
# AI proxy server
# ----------------------------------------------------------------------------
PORT=3001
