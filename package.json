{
  "name": "mediconnect-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MediConnect AI - an AI-powered healthcare website (React + TypeScript + Vite + Tailwind CSS + Supabase + secure AI chatbot).",
  "keywords": [
    "healthcare",
    "chatbot",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "supabase"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
